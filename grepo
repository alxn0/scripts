#!/bin/bash
# Run a git command in every git repo found up to a given depth (default 1).
# Usage: grepo [-d DEPTH] <git args...>
#   grepo status -sb   # like the old gstatus, direct children
#   grepo fetch        # like the old gfetch
#   grepo -d 2 fetch   # also descend one level for nested repos
# Only directories containing .git are run; their subfolders are skipped (pruned).

usage() { sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; }

depth=1
while getopts "d:h" opt; do
  case "$opt" in
    d) depth=$OPTARG ;;
    h) usage; exit 0 ;;
    *) usage; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if ! [[ "$depth" =~ ^[1-9][0-9]*$ ]]; then
  echo "grepo: depth must be a positive integer, got '$depth'" >&2
  exit 1
fi

if [ "$#" -eq 0 ]; then
  echo "grepo: no git command given" >&2
  usage >&2
  exit 1
fi

# shellcheck disable=SC2016  # the inner sh expands $d/$@/$?, not the outer shell
exec find . -mindepth 1 -maxdepth "$depth" -type d \
  -exec test -e '{}/.git' \; -prune \
  -exec sh -c '
    d=$1; shift
    echo "$d"
    cd "$d" 2>/dev/null || { echo "grepo: cannot enter $d, skipping" >&2; exit 0; }
    git "$@" || echo "grepo: git ${1:-} failed in $d (exit $?), continuing" >&2
    echo
  ' sh '{}' "$@" \;
