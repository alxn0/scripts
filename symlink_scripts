#!/bin/bash
# Create a symlink of scripts folder to $HOME

# Get the folder path in which this script is located
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Link the scripts folder as $HOME/scripts; -n replaces an existing link
# instead of nesting a new one inside it, so re-runs are safe
ln -sfn "$DIR" "$HOME/scripts"
ls -l "$HOME/scripts"
